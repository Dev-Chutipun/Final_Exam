# คัดลอกเป็น .env ที่ root ของ repo
# OIDC_CLIENT_SECRET ใช้บนเครื่องเท่านั้น (ข้อยกเว้นเรื่อง secret ดู README)

DATABASE_URL=postgres://devpool:devpool@localhost:5432/devpool?sslmode=disable
TEST_DATABASE_URL=postgres://devpool:devpool@localhost:5432/devpool_test?sslmode=disable
PORT=8080
PUBLIC_BASE_URL=http://localhost:3000
OIDC_ISSUER=http://localhost:8081/realms/devpool
OIDC_CLIENT_ID=devpool-web
OIDC_CLIENT_SECRET=devpool-local-secret
COOKIE_SECURE=false
API_ORIGIN=http://localhost:8080
